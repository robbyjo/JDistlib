# Historical Java sources use a mixture of LF and CRLF. Treat CR as part of
# the line ending so whitespace checks do not flag otherwise unchanged files.
*.java whitespace=cr-at-eol

# Keep repository infrastructure deterministic across platforms.
.gitattributes text eol=lf
*.md text eol=lf
*.gradle text eol=lf
*.yml text eol=lf
*.properties text eol=lf
# Patch artifacts may contain format-significant whitespace from upstream
# context and saved console transcripts.
*.patch text eol=lf whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab
*.c text eol=lf
*.R text eol=lf
gradlew text eol=lf
*.bat -text
