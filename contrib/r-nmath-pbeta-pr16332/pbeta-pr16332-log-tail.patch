+/*
+ * Compute log(I_x(a,b)) with a modified-Lentz continued fraction.  This is
+ * a fallback for rare extreme log-scale BPSER failures in PR#16332, not a
+ * replacement for the TOMS 708 method selection above.
+ */
+static double ibeta_lentz_log_cf(double a, double b, double x, double y)
+{
+    const double fpmin = DBL_MIN / DBL_EPSILON;
+    const double tolerance = 4. * DBL_EPSILON;
+    double qab = a + b, qap = a + 1., qam = a - 1.;
+    double c = 1.;
+    double d = 1. - qab * x / qap;
+    if (fabs(d) < fpmin) d = copysign(fpmin, d);
+    d = 1. / d;
+    double fraction = d;
+    Rboolean converged = FALSE;
+
+    for (int m = 1; m <= 10000; m++) {
+	double m2 = 2. * m;
+	double coefficient = m * (b - m) * x /
+	    ((qam + m2) * (a + m2));
+	d = 1. + coefficient * d;
+	if (fabs(d) < fpmin) d = copysign(fpmin, d);
+	c = 1. + coefficient / c;
+	if (fabs(c) < fpmin) c = copysign(fpmin, c);
+	d = 1. / d;
+	fraction *= d * c;
+
+	coefficient = -(a + m) * (qab + m) * x /
+	    ((a + m2) * (qap + m2));
+	d = 1. + coefficient * d;
+	if (fabs(d) < fpmin) d = copysign(fpmin, d);
+	c = 1. + coefficient / c;
+	if (fabs(c) < fpmin) c = copysign(fpmin, c);
+	d = 1. / d;
+	double delta = d * c;
+	fraction *= delta;
+	if (fabs(delta - 1.) <= tolerance) {
+	    converged = TRUE;
+	    break;
+	}
+    }
+
+    if (!converged)
+	ML_WARNING(ME_NOCONV, "pbeta");
+    if (!(fraction > 0.) || !R_FINITE(fraction))
+	return ML_NAN;
+    return brcomp(a, b, x, y, TRUE) - log(a) + log(fraction);
+}
+
+static double ibeta_lentz_log(double a, double b, double x)
+{
+    double y = 0.5 - x + 0.5;
+    /* Compute the crossover without overflowing a+b. */
+    double scale = fmax2(fmax2(a, b), 1.);
+    double crossover = (a / scale + 1. / scale) /
+	(a / scale + b / scale + 2. / scale);
+    if (x > crossover) {
+	double log_upper = ibeta_lentz_log_cf(b, a, y, x);
+	return R_FINITE(log_upper) ? R_Log1_Exp(log_upper) : log_upper;
+    }
+    return ibeta_lentz_log_cf(a, b, x, y);
+}
