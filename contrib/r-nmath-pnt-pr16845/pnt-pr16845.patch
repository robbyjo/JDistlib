+typedef struct {
+    double t, df, ncp;
+    int lower_tail;
+} pnt_quad_context;
+
+static double pnt_quad_integrand(double z, const pnt_quad_context *ctx)
+{
+    double ratio = (z + ctx->ncp) / ctx->t;
+    double threshold = ctx->df * ratio * ratio;
+    double conditional = pchisq(threshold, ctx->df,
+				!ctx->lower_tail, FALSE);
+    return dnorm4(z, 0., 1., FALSE) * conditional;
+}
+
+static double pnt_adaptive_simpson(const pnt_quad_context *ctx,
+				   double left, double right,
+				   double fleft, double fmid, double fright,
+				   double whole, double tolerance,
+				   int depth, int *ok)
+{
+    double mid = (left + right) / 2.;
+    double left_mid = (left + mid) / 2.;
+    double right_mid = (mid + right) / 2.;
+    double flm = pnt_quad_integrand(left_mid, ctx);
+    double frm = pnt_quad_integrand(right_mid, ctx);
+    if (!R_FINITE(flm) || !R_FINITE(frm)) {
+	*ok = FALSE;
+	return ML_NAN;
+    }
+    double left_value = (mid - left) * (fleft + 4.*flm + fmid) / 6.;
+    double right_value = (right - mid) * (fmid + 4.*frm + fright) / 6.;
+    double combined = left_value + right_value;
+    double error = combined - whole;
+    if (depth <= 0 || fabs(error) <= 15.*tolerance)
+	return combined + error / 15.;
+    return pnt_adaptive_simpson(ctx, left, mid, fleft, flm, fmid,
+				left_value, tolerance/2., depth-1, ok)
+	 + pnt_adaptive_simpson(ctx, mid, right, fmid, frm, fright,
+				right_value, tolerance/2., depth-1, ok);
+}
+
+static double pnt_integrate_piece(const pnt_quad_context *ctx,
+				  double left, double right, int *ok)
+{
+    double mid = (left + right) / 2.;
+    double fleft = pnt_quad_integrand(left, ctx);
+    double fmid = pnt_quad_integrand(mid, ctx);
+    double fright = pnt_quad_integrand(right, ctx);
+    if (!R_FINITE(fleft) || !R_FINITE(fmid) || !R_FINITE(fright)) {
+	*ok = FALSE;
+	return ML_NAN;
+    }
+    double whole = (right-left) * (fleft + 4.*fmid + fright) / 6.;
+    return pnt_adaptive_simpson(ctx, left, right, fleft, fmid, fright,
+				whole, 2e-14, 20, ok);
+}
+
+static double pnt_large_ncp(double t, double df, double ncp,
+			    int lower_tail)
+{
+    pnt_quad_context ctx = { t, df, ncp, lower_tail };
+    double result = lower_tail ? pnorm(-ncp, 0., 1., TRUE, FALSE) : 0.;
+    double lower = fmax2(-ncp, -10.);
+    if (!(lower < 10.)) return result;
+
+    double points[] = { lower, -5., 0., 5., t-ncp, 10. };
+    const int count = sizeof(points) / sizeof(points[0]);
+    for (int i = 1; i < count; i++) {
+	double value = points[i];
+	int j = i;
+	while (j > 0 && points[j-1] > value) {
+	    points[j] = points[j-1];
+	    j--;
+	}
+	points[j] = value;
+    }
+
+    double from = lower, correction = 0.;
+    int ok = TRUE;
+    for (int i = 0; i < count; i++) {
+	double to = points[i];
+	if (!(to > from) || to > 10.) continue;
+	double value = pnt_integrate_piece(&ctx, from, to, &ok);
+	if (!ok || !R_FINITE(value)) return ML_NAN;
+	double adjusted = value - correction;
+	double next = result + adjusted;
+	correction = (next - result) - adjusted;
+	result = next;
+	from = to;
+	if (from == 10.) break;
+    }
+    return fmin2(fmax2(result, 0.), 1.);
+}
