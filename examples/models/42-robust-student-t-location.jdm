data { int<lower=1> N; vector[N] y; }
parameters { real mu; real<lower=0> sigma; real<lower=0> nu_minus_two; }
transformed parameters { real nu = nu_minus_two + 2; }
model {
  mu ~ normal(0,5); sigma ~ lognormal(0,1); nu_minus_two ~ exponential(0.2);
  y ~ student_t(nu,mu,sigma);
}
generated quantities { real y_rep = student_t_rng(nu,mu,sigma); }
