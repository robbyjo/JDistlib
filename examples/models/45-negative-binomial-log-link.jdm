data { real x; int<lower=0> y; }
parameters { real intercept; real slope; real<lower=0> dispersion; }
transformed parameters { real log_mean = intercept + slope*x; }
model {
  intercept ~ normal(0,2); slope ~ normal(0,1); dispersion ~ lognormal(1,1);
  y ~ neg_binomial_2_log(log_mean,dispersion);
}
generated quantities { int y_rep = neg_binomial_2_log_rng(log_mean,dispersion); }
